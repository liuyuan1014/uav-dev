<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uav.service.mapper.MissionJobMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.uav.service.domain.MissionJob">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="mission_id" property="missionId" jdbcType="BIGINT"/>
        <result column="job_id" property="jobId" jdbcType="INTEGER"/>
        <result column="job_desc" property="jobDesc" jdbcType="VARCHAR"/>
        <result column="schedule_conf" property="scheduleConf" jdbcType="VARCHAR"/>
        <result column="executor_handler" property="executorHandler" jdbcType="VARCHAR"/>
        <result column="executor_param" property="executorParam" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, mission_id, job_id, job_desc, schedule_conf, executor_handler, 
        executor_param, status, remark, create_time, update_time
    </sql>

    <!-- 根据任务ID查询 -->
    <select id="selectByMissionId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mission_job
        WHERE mission_id = #{missionId}
        AND deleted = 0
        LIMIT 1
    </select>

    <!-- 根据XXL-JOB任务ID查询 -->
    <select id="selectByJobId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mission_job
        WHERE job_id = #{jobId}
        AND deleted = 0
        LIMIT 1
    </select>

    <!-- 更新任务状态 -->
    <update id="updateStatus">
        UPDATE mission_job
        SET status = #{status},
            update_time = NOW()
        WHERE id = #{id}
        AND deleted = 0
    </update>

</mapper>